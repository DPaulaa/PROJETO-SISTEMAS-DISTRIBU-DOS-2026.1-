  "paths": {
    "/api/v1/debug/info": {
      "get": {
        "tags": [
          "Debug"
        ],
        "summary": "Informações de diagnóstico do serviço.",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/v1/debug/crash": {
      "get": {
        "tags": [
          "Debug"
        ],
        "summary": "Simula uma exceção 500 para fins didáticos.",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/v1/livros": {
      "get": {
        "tags": [
          "Livros"
        ],
        "summary": "Lista todos os livros da biblioteca.",
