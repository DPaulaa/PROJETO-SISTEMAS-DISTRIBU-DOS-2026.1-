  "components": {
    "schemas": {
      "LivroRequest": {
        "required": [
          "autor",
          "titulo"
        ],
        "type": "object",
        "properties": {
          "titulo": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "autor": {
            "maxLength": 150,
            "minLength": 1,
            "type": "string"
          },
          "isbn": {
            "maxLength": 20,
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false,
        "description": "Dados que o cliente envia ao criar ou atualizar um livro."
      },
      "LivroResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "titulo": {
            "type": "string",
            "nullable": true
          },
          "autor": {
            "type": "string",
            "nullable": true
          },
          "isbn": {
            "type": "string",
            "nullable": true
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": false,
        "description": "Dados que a API retorna ao cliente — nunca a entidade diretamente."
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "nullable": true
          },
          "title": {
            "type": "string",
            "nullable": true
          },
          "status": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "detail": {
            "type": "string",
            "nullable": true
          },
          "instance": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": { }
      }
    }
  },
  "tags": [
    {
      "name": "Debug"
    },
    {
      "name": "Livros"
    },
    {
      "name": "Protegido"
    }
  ]
}